<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <include layout="@layout/view_brand_bar" />

        <!-- ================= 连接状态 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.DriveSync.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="连接状态" />

                <TextView
                    android:id="@+id/tvConnStatus"
                    style="@style/Text.DriveSync.Mono"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="2"
                    android:text="未连接" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSyncStatus"
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="—" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    style="@style/Widget.DriveSync.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:text="连接" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDisconnect"
                    style="@style/Widget.DriveSync.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="断开" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swPause"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="暂停剪切板同步（连接保持）"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- ================= 中继配置 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.DriveSync.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中继与设备" />

            <TextView
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="端到端加密；中继只转发密文。可连自建 drive-relay。" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DriveSync.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="中继地址（ws://局域网:8787/ws 或 wss://公网域名/ws）">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRelay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DriveSync.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="共享访问令牌（access_token）">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textVisiblePassword"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DriveSync.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="本机设备名">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDeviceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveConfig"
                style="@style/Widget.DriveSync.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="保存配置并初始化设备" />
        </LinearLayout>

        <!-- ================= 配对 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.DriveSync.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="配对" />

            <TextView
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="一次性 8 位码 + SAS 校验；配对长期有效，90 天不活跃自动失效。" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPairStart"
                style="@style/Widget.DriveSync.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="发起配对（生成 8 位码）" />

            <TextView
                android:id="@+id/tvPairCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="—"
                android:textColor="@color/mint"
                android:textIsSelectable="true"
                android:textSize="24sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DriveSync.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="对端 8 位配对码（或扫码串）">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etJoinCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPairJoin"
                style="@style/Widget.DriveSync.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="加入配对" />

            <TextView
                android:id="@+id/tvPairStatus"
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="—" />
        </LinearLayout>

        <!-- ================= 剪切板 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.DriveSync.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="剪切板" />

            <TextView
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="前台自动发送；后台接收自动写剪贴板 + 通知；后台发送可一键完成。" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendClipboard"
                style="@style/Widget.DriveSync.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="立即发送当前剪贴板" />

            <TextView
                android:id="@+id/tvClipboard"
                style="@style/Text.DriveSync.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="8"
                android:text="（空）"
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/tvPermissionHint"
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="后台发送：下拉通知栏点「同步当前剪贴板」，或开启悬浮同步球。" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPermissions"
                style="@style/Widget.DriveSync.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="权限与后台同步" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.DriveSync.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="设置与外观主题" />

            <TextView
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="敏感提示：剪切板内容可能包含密码/令牌；全程 E2E 加密，但请勿在不可信设备上启用。" />
        </LinearLayout>

        <!-- ================= 在线设备 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.DriveSync.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="在线设备" />

            <TextView
                android:id="@+id/tvPeers"
                style="@style/Text.DriveSync.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="（未加载）" />
        </LinearLayout>

        <!-- ================= 软件目录 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.DriveSync.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="软件目录（只读）" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefresh"
                style="@style/Widget.DriveSync.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="刷新状态 / 设备 / 目录" />

            <TextView
                android:id="@+id/tvCatalog"
                style="@style/Text.DriveSync.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="（未加载）" />
        </LinearLayout>

        <TextView
            style="@style/Text.DriveSync.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="drive-sync v0.3.2 · 端到端加密 · 全部操作在 App 内完成" />

    </LinearLayout>
</ScrollView>
