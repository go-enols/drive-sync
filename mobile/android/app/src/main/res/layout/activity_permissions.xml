<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <include layout="@layout/view_brand_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.DriveSync.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← 返回" />

            <TextView
                style="@style/Text.DriveSync.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="权限与后台同步" />
        </LinearLayout>

        <!-- ================= 基础权限 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.DriveSync.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="基础权限" />

            <TextView
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="均在 App 内申请，无需 adb / root；可随时在系统设置关闭。" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.DriveSync.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="通知权限（Android 13+）" />

                    <TextView
                        android:id="@+id/tvNotifStatus"
                        style="@style/Text.DriveSync.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="未授权" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotifGrant"
                    style="@style/Widget.DriveSync.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="去开启" />
            </LinearLayout>

            <TextView
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="用途：接收远端剪切板提醒、显示「同步当前剪贴板」一键按钮。" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="@color/border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.DriveSync.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="电池优化豁免（可选）" />

                    <TextView
                        android:id="@+id/tvBatteryStatus"
                        style="@style/Text.DriveSync.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="未授权" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatteryGrant"
                    style="@style/Widget.DriveSync.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="去开启" />
            </LinearLayout>

            <TextView
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="用途：保持前台服务存活，减少后台同步被系统冻结的概率。" />
        </LinearLayout>

        <!-- ================= 后台一键同步 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.DriveSync.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="后台一键同步" />

            <TextView
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Android 10+ 禁止后台应用读取剪贴板（普通权限无解）。后台发送时点通知栏「同步当前剪贴板」或悬浮球即可，一次点击完成。" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.DriveSync.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="悬浮窗权限（可选）" />

                    <TextView
                        android:id="@+id/tvOverlayStatus"
                        style="@style/Text.DriveSync.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="未授权" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlayGrant"
                    style="@style/Widget.DriveSync.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="去开启" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swFloatingBall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="悬浮同步球"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvFloatingHint"
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="授权悬浮窗后可开启；后台发送只需点一下小球。" />
        </LinearLayout>

        <!-- ================= 开机自启 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.DriveSync.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开机自启（可选）" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swBootStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="开机后自动恢复后台同步"
                android:textColor="@color/text_primary" />

            <TextView
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Android 14/15 对开机启动 dataSync 前台服务有限制；被系统拒绝时会发通知，点按打开 App 即可恢复。" />
        </LinearLayout>

        <!-- ================= 当前状态 / 能力边界 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.DriveSync.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前能力状态" />

            <TextView
                android:id="@+id/tvDegraded"
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="检查中…" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/border" />

            <TextView
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="能力边界（Android 系统限制）" />

            <TextView
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="• 前台：双向自动同步（无感）" />

            <TextView
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="• 后台接收：自动写剪贴板 + 通知（无感）" />

            <TextView
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="• 后台发送：需一次点击（通知按钮 / 悬浮球）" />

            <TextView
                style="@style/Text.DriveSync.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="• 完全后台静默发送需要 root / 默认输入法等特殊手段，本项目不要求" />
        </LinearLayout>

        <TextView
            style="@style/Text.DriveSync.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="drive-sync v0.3.0 · 所有权限均在 App 内引导申请" />

    </LinearLayout>
</ScrollView>
